# FixFlow Environment Configuration Example
# Copy this file to '.env' and populate your values if needed:
# cp .env.example .env

# Optional: Google Gemini API Key for LLM-assisted multi-tone polishing and prompt enhancements
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name recognized by Google GenAI:
# GOOGLE_API_KEY=your_google_api_key_here

# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

